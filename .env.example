# ==========================================
# Configurações da API MyAnimeList (OAuth2)
# ==========================================
# Seu Client ID cadastrado no MyAnimeList Developer API
CLIENT_ID=seu_client_id_aqui

# Seu Client Secret do MyAnimeList API
CLIENT_SECRET=seu_client_secret_aqui

# URL de callback configurada na sua aplicação do MAL (ex: http://localhost:8000/api/v1/auth/callback)
REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Endpoint de emissão/renovação de tokens do MAL
TOKEN_URL=https://myanimelist.net/v1/oauth2/token

# ==========================================
# Configurações do Banco de Dados
# ==========================================
# Exemplo para PostgreSQL no Docker/WSL:
# DATABASE_URL=postgresql://animind_user:animind_password@localhost:5432/animind_db
# 
# Para usar SQLite local em desenvolvimento, deixe comentado ou defina:
# DATABASE_URL=sqlite:///./animind.db
DATABASE_URL=sqlite:///./animind.db

# ==========================================
# Configurações do Worker ETL (RSS)
# ==========================================
# Periodicidade de execução do ETL em minutos (ex: 15 para rodar a cada 15 minutos)
ETL_INTERVAL_MINUTES=15

# ==========================================
# Segurança e Sessão
# ==========================================

SESSION_SECRET_KEY=sua_chave_secreta_super_segura_2026
