# ==============================================================================
# aniMind - Configurações de Ambiente (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ESSENCIAIS (Obrigatório para rodar a API Web e Dashboard)
# ------------------------------------------------------------------------------
# Conexão com o Banco de Dados PostgreSQL (Supabase ou local)
DATABASE_URL=postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Seu Client ID da API oficial do MyAnimeList (usado para enriquecer animes e perfis)
CLIENT_ID=seu_client_id_do_mal

# ------------------------------------------------------------------------------
# 2. AUTENTICAÇÃO MAL OAUTH (Opcional - apenas para login administrativo formal)
# ------------------------------------------------------------------------------
# Se omitido, o login formal fica desativado, mas qualquer usuário pode ser sincronizado pelo nome
CLIENT_SECRET=
# REDIRECT_URI é auto-detectado dinamicamente (local ou Render), defina apenas se usar domínio customizado
# REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
SESSION_SECRET_KEY=chave_secreta_para_sessao_oauth_2026

# ------------------------------------------------------------------------------
# 3. WORKERS E INTEGRAÇÃO DE API (Opcional)
# ------------------------------------------------------------------------------
# Usado pelos extratores para se comunicarem com a API do AniMind
# Localmente cai para http://localhost:8000/api/v1. Na nuvem, aponte para o Render:
# API_BASE_URL=https://sua-api.onrender.com/api/v1
RSS_TRIGGER_INTERVAL=15

# ------------------------------------------------------------------------------
# 4. DATA LAKE S3 / SUPABASE STORAGE (Opcional - Usado nos Workflows do GitHub)
# ------------------------------------------------------------------------------
# Se não preenchido, os scripts PySpark e Lakehouse salvam localmente na pasta /data_lake
# SUPA_LAKE_ENDPOINT=https://xxxx.storage.supabase.co/storage/v1/s3
# SUPA_LAKE_REGION=sa-east-1
# SUPA_LAKE_ACCESS_KEY=seu_access_key_s3
# SUPA_LAKE_SECRET_KEY=seu_secret_key_s3
# SUPA_LAKE_BUCKET=animind-lake

# ------------------------------------------------------------------------------
# 5. ORQUESTRAÇÃO PREFECT CLOUD (Opcional)
# ------------------------------------------------------------------------------
# Se não preenchido, o Prefect executa localmente sem enviar telemetria para a nuvem
# PREFECT_API_KEY=pnu_xxxx
# PREFECT_API_URL=https://api.prefect.cloud/api/accounts/xxxx/workspaces/xxxx
